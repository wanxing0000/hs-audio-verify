.page {
  min-height: 100vh;
  padding: 16px 14px 156px;
  background: linear-gradient(180deg, #1a2133 0%, #141824 42%, #12141c 100%);
  color: #f3efe6;
}
.hero { margin-bottom: 16px; }
.kicker {
  color: rgba(215, 181, 109, 0.72);
  font-size: 11px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}
.title {
  margin-top: 4px;
  color: #f4ead4;
  font-size: 24px;
  font-weight: 800;
  letter-spacing: 0.03em;
}
.sub {
  margin-top: 6px;
  color: #f3efe6;
  font-size: 16px;
  font-weight: 700;
  line-height: 1.5;
}
.count {
  margin-top: 4px;
  color: #9aa3b5;
  font-size: 13px;
}
.state {
  margin-top: 28px;
  padding: 28px 8px;
  text-align: center;
  color: #9aa3b5;
  font-size: 15px;
  line-height: 1.6;
}
.fail-title {
  margin-bottom: 8px;
  color: #f3efe6;
  font-size: 18px;
  font-weight: 700;
}
.retry {
  margin-top: 16px;
  width: 160px;
  min-height: 44px;
  line-height: 44px;
  border-radius: 999px;
  background: #d7b56d;
  color: #1a1408;
  font-size: 15px;
  font-weight: 700;
}
.retry::after { border: none; }
.class-section { margin-top: 18px; }
.class-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 0 2px 10px;
  padding-bottom: 8px;
  border-bottom: 1px solid rgba(58, 66, 88, 0.9);
}
.class-name {
  color: #d7c9a3;
  font-size: 15px;
  font-weight: 700;
}
.class-count {
  color: #9aa3b5;
  font-size: 12px;
}
.grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -6px;
}
.cell {
  width: 50%;
  padding: 0 6px 14px;
  box-sizing: border-box;
}
.empty {
  padding: 36px 8px;
  text-align: center;
  color: #9aa3b5;
}
.footer {
  padding: 8px 8px 12px;
  text-align: center;
}
.foot-text {
  color: #7d8699;
  font-size: 12px;
}
.foot-fail {
  color: #d7b56d;
  font-size: 13px;
  font-weight: 600;
  min-height: 40px;
  line-height: 40px;
}
.back-top {
  position: fixed;
  right: 16px;
  bottom: calc(132px + env(safe-area-inset-bottom));
  z-index: 30;
  width: 44px;
  height: 44px;
  line-height: 44px;
  text-align: center;
  border-radius: 50%;
  background: rgba(28, 33, 48, 0.88);
  border: 1px solid rgba(215, 181, 109, 0.45);
  color: #f3efe6;
  font-size: 20px;
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.28);
}
.back-top-hover { opacity: 0.82; transform: scale(0.96); }
.pad { height: 8px; }
