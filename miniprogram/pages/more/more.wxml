<view class="page">
  <view class="hero">
    <view class="kicker">More</view>
    <view class="title">更多</view>
    <view class="sub">更多功能陆续开放</view>
  </view>

  <view class="list">
    <view class="row" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="onTapItem">
      <view class="row-title">{{item.title}}</view>
      <view class="row-hint">{{item.hint}}</view>
    </view>
  </view>

  <view class="form" wx:if="{{showForm}}">
    <view class="form-title">意见反馈</view>
    <view class="label">类型</view>
    <picker mode="selector" range="{{types}}" range-key="label" value="{{typeIndex}}" bindchange="onTypeChange">
      <view class="picker">{{types[typeIndex].label}}</view>
    </picker>
    <view class="label">内容</view>
    <textarea
      class="textarea"
      maxlength="2000"
      value="{{message}}"
      placeholder="请描述你遇到的问题或建议"
      bindinput="onMessageInput"
    />
    <view class="count">{{charCount}} / 2000</view>
    <button class="submit" disabled="{{submitting}}" bindtap="submitFeedback">
      {{submitting ? '提交中...' : '提交'}}
    </button>
    <view class="ok" wx:if="{{result}}">{{result}}</view>
    <view class="err" wx:if="{{error}}">{{error}}</view>
  </view>

  <view class="pad"></view>
  <mini-player lift-for-tab-bar="{{true}}" />
</view>
