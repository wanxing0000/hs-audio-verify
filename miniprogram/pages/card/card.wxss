.page {
  min-height: 100vh;
  padding: 12px 16px 108px;
  background: linear-gradient(180deg, #1a2133 0%, #141824 100%);
  color: #f3efe6;
}
.art {
  width: 72%;
  max-width: 280px;
  display: block;
  margin: 0 auto 12px;
  border-radius: 16px;
  background: #1a1d28;
  box-shadow: 0 12px 28px rgba(0, 0, 0, 0.28);
}
.art.legendary {
  box-shadow: 0 12px 28px rgba(0, 0, 0, 0.28), 0 0 0 2px #d7b56d;
}
.head { text-align: center; margin-bottom: 12px; }
.name {
  font-size: 22px;
  font-weight: 700;
}
.meta {
  margin-top: 6px;
  color: #d7b56d;
  font-size: 14px;
}
.hint {
  margin-top: 8px;
  color: #9aa3b5;
  font-size: 12px;
}
.special {
  margin: 0 0 16px;
  padding: 10px 12px;
  border-radius: 10px;
  background: #232838;
  color: #c5cddd;
  font-size: 13px;
  line-height: 1.5;
  text-align: center;
}
.text {
  margin: 8px 0;
  line-height: 1.55;
  font-size: 15px;
  white-space: pre-wrap;
}
.flavor {
  margin: 0 0 16px;
  color: #9aa3b5;
  font-size: 13px;
  line-height: 1.5;
}
.entrance-wrap { margin: 8px 0 16px; }
.entrance-kicker {
  text-align: center;
  color: #9aa3b5;
  font-size: 12px;
  margin-bottom: 8px;
}
.entrance {
  margin: 0;
  min-height: 48px;
  line-height: 48px;
  border-radius: 14px;
  background: linear-gradient(180deg, #e4c888, #c9a24e);
  color: #1a1408;
  font-size: 16px;
  font-weight: 800;
}
.entrance-hover { opacity: 0.9; }
.entrance::after { border: none; }
.tracks { margin-top: 4px; }
.empty {
  padding: 48px 16px;
  text-align: center;
  color: #9aa3b5;
  line-height: 1.6;
}
.fail-title {
  margin-bottom: 8px;
  color: #f3efe6;
  font-size: 18px;
  font-weight: 700;
}
.retry {
  margin-top: 16px;
  width: 160px;
  min-height: 44px;
  line-height: 44px;
  border-radius: 999px;
  background: #d7b56d;
  color: #1a1408;
  font-size: 15px;
  font-weight: 700;
}
.retry::after { border: none; }
.audio-debug {
  margin: 16px 0 8px;
  padding: 10px 12px;
  border-radius: 10px;
  background: #12151f;
  color: #9aa3b5;
  font-size: 11px;
  line-height: 1.45;
  word-break: break-all;
}
.audio-debug-src,
.audio-debug-line {
  margin-top: 4px;
  color: #7d8699;
}
