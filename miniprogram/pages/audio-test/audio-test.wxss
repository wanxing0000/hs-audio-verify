.page {
  min-height: 100vh;
  padding: 12px 16px 56px;
  background: #141824;
  color: #f3efe6;
  font-size: 13px;
  line-height: 1.45;
}
.h { font-size: 18px; font-weight: 700; margin-bottom: 8px; }
.h2 { margin: 14px 0 6px; color: #d7b56d; font-weight: 600; }
.meta, .url, .log, .http, .note, .hint {
  margin-bottom: 6px;
  word-break: break-all;
  color: #9aa3b5;
}
.hint {
  color: #f3efe6;
  background: #1a2133;
  padding: 8px 10px;
  border-radius: 8px;
}
.note { font-size: 12px; }
button {
  margin: 6px 0 0;
  background: #2a3144;
  color: #f3efe6;
  font-size: 14px;
}
button::after { border: none; }
.log, .http { font-family: monospace; font-size: 11px; }
