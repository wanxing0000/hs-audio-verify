.item {
  background: #1c2232;
  border: 1px solid #343a4d;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 10px 22px rgba(0, 0, 0, 0.22);
}
.item.legendary {
  border-color: rgba(215, 181, 109, 0.7);
  box-shadow: 0 10px 24px rgba(0, 0, 0, 0.26), 0 0 0 1px rgba(215, 181, 109, 0.18);
}
.item-hover {
  opacity: 0.92;
  transform: scale(0.985);
}
.art {
  width: 100%;
  height: auto;
  aspect-ratio: 256 / 388;
  display: block;
  background: #151922;
}
.body {
  padding: 10px 10px 12px;
}
.name {
  min-height: 36px;
  font-size: 14px;
  font-weight: 700;
  line-height: 1.3;
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.sub {
  margin-top: 4px;
  color: #8b93a7;
  font-size: 11px;
}
.play {
  margin-top: 10px;
  min-height: 40px;
  line-height: 40px;
  text-align: center;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 700;
}
.play-entrance {
  background: linear-gradient(180deg, #e4c888, #c9a24e);
  color: #1a1408;
}
.play-voice {
  background: #2c3348;
  color: #f3efe6;
  border: 1px solid #4a5470;
}
.play-music {
  background: #3a3228;
  color: #f3e6c8;
  border: 1px solid #c9a24e;
}
.play-hover { opacity: 0.88; }
