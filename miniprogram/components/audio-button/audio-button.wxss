.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 12px 0;
  min-height: 56px;
  border-bottom: 1px solid #343a4d;
}
.copy { flex: 1; min-width: 0; }
.label {
  font-size: 16px;
  font-weight: 700;
}
.note {
  display: block;
  margin-top: 4px;
  color: #9aa3b5;
  font-size: 12px;
}
.btn {
  flex-shrink: 0;
  margin: 0;
  min-width: 96px;
  min-height: 44px;
  padding: 0 16px;
  line-height: 44px;
  border-radius: 999px;
  background: #d7b56d;
  color: #1a1408;
  font-size: 14px;
  font-weight: 700;
}
.btn-hover { opacity: 0.86; }
.btn::after { border: none; }
.row-off { opacity: 0.72; }
.off {
  flex-shrink: 0;
  min-width: 96px;
  text-align: right;
  color: #9aa3b5;
  font-size: 13px;
}
