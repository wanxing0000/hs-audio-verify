# Copy to .env on the server. Do not commit real values.

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

MINI_HOST=0.0.0.0
MINI_PORT=8767

NODE_ENV=production
HS_AUDIO_SOURCE=production

# Optional. Production start defaults this to 1 so Mini does not write miniprogram LAN files.
# MINI_SKIP_LAN_WRITE=1

# Optional listen/banner override. Leave empty on a typical VPS.
# MINI_API_BASE=
